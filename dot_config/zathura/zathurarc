# set guioptions "s"
set statusbar-h-padding 0
set statusbar-v-padding 0
set recolor true
set recolor-keephue true
set window-title-basename true
set scroll-step 100
set selection-clipboard clipboard
map j scroll smooth-down
map k scroll smooth-up
map h scroll left
map l scroll right
map b toggle_statusbar
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print
map g goto top
map <C-r> feedkeys ":source<Return>"
include ../../.cache/wal/zathura-colors
