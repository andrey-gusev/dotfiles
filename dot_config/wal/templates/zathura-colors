set default-bg                     "{background}"
set default-fg                     "{foreground}"

set statusbar-bg                   "rgba({color12.rgb},0.85)"
set statusbar-fg                   "{background}"

set inputbar-bg                    "rgba({color8.rgb},0.85)"
set inputbar-fg                    "{foreground}"

set notification-bg                "rgba({background.rgb},0.9)"
set notification-fg                "{foreground}"

set notification-error-bg          "rgba({background.rgb},0.9)"
set notification-error-fg          "{color1}"

set notification-warning-bg        "rgba({background.rgb},0.9)"
set notification-warning-fg        "{color3}"

set highlight-color                "rgba({color10.rgb},0.5)"
set highlight-active-color         "rgba({color14.rgb},0.65)"

set completion-bg                  "rgba({color8.rgb},0.9)"
set completion-fg                  "{foreground}"
set completion-highlight-bg        "rgba({color12.rgb},0.8)"
set completion-highlight-fg        "{background}"

set recolor-lightcolor             "{background}"
set recolor-darkcolor              "{color10}"
