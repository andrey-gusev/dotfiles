set default-bg                      "{background}"
set default-fg                      "{foreground}"

# Статус-бар: глубокий тёмный фон + контрастный светлый текст
set statusbar-bg                    "{color0}"
set statusbar-fg                    "{foreground}"

set inputbar-bg                     "{color0}"
set inputbar-fg                     "{foreground}"

# Уведомления
set notification-bg                 "{color0}"
set notification-fg                 "{foreground}"

set notification-error-bg           "{color1}"
set notification-error-fg           "{background}"

set notification-warning-bg         "{color3}"
set notification-warning-fg         "{background}"

# Полупрозрачное выделение при поиске
set highlight-color                 "rgba({color11.rgb},0.4)"
set highlight-active-color          "rgba({color9.rgb},0.6)"

# Автодополнение команд
set completion-bg                   "{color0}"
set completion-fg                   "{foreground}"
set completion-highlight-bg         "{color12}"
set completion-highlight-fg         "{background}"

# Перекрашивание документов (Recolor)
set recolor-lightcolor              "{background}"
set recolor-darkcolor               "{foreground}"
