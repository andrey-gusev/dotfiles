#!/usr/bin/env bash

IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -E '^(tun|tap|wg|wireguard|proton|tailscale)' | head -n 1)

if [ -n "$IFACE" ]; then
  IP=$(ip -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)

  if [ "$1" = "--copy" ]; then
    echo -n "$IP" | wl-copy
    exit 0
  fi

  case "$IFACE" in
  tailscale*) DISPLAY_NAME="${IFACE/tailscale/tlsc}" ;;
  wireguard*) DISPLAY_NAME="${IFACE/wireguard/wg}" ;;
  proton*) DISPLAY_NAME="${IFACE/proton/prtn}" ;;
  *) DISPLAY_NAME="$IFACE" ;;
  esac

  echo "$DISPLAY_NAME:$IP"
fi
