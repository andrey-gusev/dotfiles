#!/usr/bin/env bash
set -euo pipefail

wall=""
force_default=false
random_default=false
theme_default="base16-gruvbox-hard"
pix_dir="${WALLPAPER_DIR:-$HOME/pix}"

# Парсинг флагов и аргументов
while [[ $# -gt 0 ]]; do
  case "$1" in
  -d | --default)
    force_default=true
    shift
    ;;
  -r | --random-default)
    random_default=true
    shift
    ;;
  -h | --help)
    echo "Использование: $0 [ОПЦИИ] [ПУТЬ_К_ОБОЯМ]"
    echo "  -d, --default         Применить тему по умолчанию (без обоев)"
    echo "  -r, --random-default  Применить тему по умолчанию, но выбрать случайные обои"
    echo "  -h, --help            Показать это сообщение"
    exit 0
    ;;
  *)
    if [[ -f "$1" ]]; then
      wall="$1"
    else
      echo "Ошибка: Файл '$1' не найден." >&2
      exit 1
    fi
    shift
    ;;
  esac
done

# Логика выбора обоев (запускается, только если НЕ взведен -d и НЕ был передан файл)
if ! $force_default && [[ -z "$wall" ]]; then
  if [[ -d "$pix_dir" ]]; then
    # Безопасный выбор файла через NUL-байты (устойчив к пробелам)
    wall=$(find "$pix_dir" -type f \( \
      -iname "*.jpg" -o \
      -iname "*.jpeg" -o \
      -iname "*.png" -o \
      -iname "*.avif" -o \
      -iname "*.webp" \
      \) -print0 2>/dev/null | shuf -z -n 1 | tr -d '\0')
  fi

  # Если файл так и не удалось найти — принудительно сбрасываем в default
  if [[ -z "$wall" ]]; then
    force_default=true
  fi
fi

# Применение темы и обоев
if $force_default; then
  # Явный сброс или отсутствие обоев/папки
  wal --theme "$theme_default"
  awww clear 2>/dev/null || true
elif $random_default; then
  # Статичная тема + случайная картинка из найденных
  wal --theme "$theme_default"
  awww img "$wall" --transition-type none
else
  # Генерация цветов из обоев (обычный режим)
  wal -c
  wal -i "$wall"
  awww img "$wall" --transition-type none
fi

# Перезапуск уведомлений
if command -v makoctl &>/dev/null; then
  makoctl reload || true
fi
